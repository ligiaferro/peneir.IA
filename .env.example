NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Opcional: modelo só para ler editais (padrão: OPENAI_MODEL).
OPENAI_EDITAL_MODEL=
# Similaridade mínima estrita (%) para iniciar a leitura automaticamente nos cards.
EDITAL_AUTO_READ_MIN_SIMILARITY_PERCENT=50
# Leituras de edital simultâneas por instância do servidor (1 a 4).
EDITAL_READ_CONCURRENCY=2
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
# Assina os links de descadastro dos e-mails (padrão: CRON_SECRET).
UNSUBSCRIBE_SECRET=
# E-mail de contato para privacidade/LGPD, exibido nas páginas legais.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Coleta de licitações no PNCP: UFs sempre coletadas, separadas por vírgula
# (somadas às escolhidas nos perfis; vazio = só as dos perfis), limite de
# páginas (50 itens cada) por UF, quantos dias à frente buscar prazos de
# proposta e quantas UFs consultar ao mesmo tempo (1 a 6).
PNCP_UFS=
PNCP_MAX_PAGES=20
PNCP_DAYS_AHEAD=60
PNCP_CONCURRENCY=3
